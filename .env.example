# CalDAV username (frontend needs this for URL path construction)
VITE_CALDAV_USERNAME=your_username

# Radicale connection (proxy-side only, never sent to browser)
# Use Docker container name when running in compose (joins radicale network)
RADICALE_URL=http://radicale:5232
RADICALE_USER=your_username
RADICALE_PASS=changeme

# Ollama connection (proxy-side only)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# Proxy URL for Vite dev server forwarding (dev only)
PROXY_URL=http://localhost:3001
