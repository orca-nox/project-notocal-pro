# Radicale CalDAV server URL (no trailing slash)
# Vite proxies /dav -> this URL in development to avoid CORS.
VITE_CALDAV_SERVER_URL=http://localhost:5232

# Radicale credentials
VITE_CALDAV_USERNAME=user
VITE_CALDAV_PASSWORD=password

# AI Provider: "ollama" (default) or "cloud"
VITE_AI_PROVIDER=ollama

# Ollama configuration
VITE_OLLAMA_BASE_URL=http://localhost:11434
VITE_OLLAMA_MODEL=gemma3:4b
